rules_version = '2';
// Growth Gusto · Firestore security rules (paste in Firebase console → Firestore Database → Règles → Publier).
// Data model:
//   users/{uid}                      { name, email, photo, restos: [rid] }       the person's own profile and restaurant list
//   restos/{rid}                     { name, owner, createdAt, plan: essai|essentiel|pro|complet|suspendu, pack, trialEnds, paidUntil… }   one restaurant
//                                    (the commercial fields are set by the gérant with an activation code, or by a Growth Gusto admin: js/abo.js)
//   restos/{rid}/members/{memberId}  { name, email, role: gerant|chef|equipe, joinedAt, perms?, until? }  memberId = uid (account) or a kitchen profile id
//                                    until (ms, optional, 0 = no limit): a temporary access (extra, stagiaire, js/relais.js) that ends by itself:
//                                    once passed, the person reads and writes nothing of the restaurant (isMember below)
//                                    perms (optional map): employee permissions, set only by a gérant (or copied from the invite on join)
//   restos/{rid}/{collection}/{id}   fridges, readings, lots, products, tickets, staff… (members only)
//   invites/{code}                   { rid, restoName, role, perms?, createdBy, createdAt, expiresAt (ms), uses }
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function restoPath(rid) { return /databases/$(database)/documents/restos/$(rid); }
    function memberPath(rid) { return /databases/$(database)/documents/restos/$(rid)/members/$(request.auth.uid); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    // a temporary access (members/{id}.until, ms) is over once its time has passed; no field, 0 or not a number = no limit
    function accessOk(d) { return !('until' in d) || !(d.until is number) || d.until == 0 || d.until > request.time.toMillis(); }
    function isMember(rid) { return signedIn() && exists(memberPath(rid)) && accessOk(get(memberPath(rid)).data); }
    // after the write (or the whole batch): lets a new restaurant, an import or a join write its first docs atomically
    function isMemberAfter(rid) { return signedIn() && existsAfter(memberPath(rid)) && accessOk(getAfter(memberPath(rid)).data); }
    function isGerant(rid) { return isMember(rid) && get(memberPath(rid)).data.role == 'gerant'; }
    function ownerOf(rid) { return get(restoPath(rid)).data.owner; }
    // consignes (js/consignes.js): a gérant always; then the people listed in restos/{rid}.csCfg.writers, or (no list yet) the chefs
    function canPostConsigne(rid) {
      let w = get(restoPath(rid)).data.get('csCfg', {}).get('writers', null);
      return isGerant(rid) || (w == null ? get(memberPath(rid)).data.role == 'chef' : me() in w);
    }
    function validRole(r) { return r in ['gerant', 'chef', 'equipe']; }
    // perms is optional; when present it must be a map
    function validPerms(d) { return !('perms' in d) || d.perms is map; }
    function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
    function resaPubPath(rid) { return /databases/$(database)/documents/restos/$(rid)/public/resa; }
    function resaBookingPath(rid, bid) { return /databases/$(database)/documents/restos/$(rid)/bookings/$(bid); }
    function resaFieldsOk(b) {
      return b.keys().hasOnly(['date', 'time', 'covers', 'name', 'phone', 'email', 'notes', 'optin', 'status', 'source', 'createdAt', 'at'])
        && b.keys().hasAll(['date', 'time', 'covers', 'name', 'phone', 'status', 'source', 'createdAt', 'at'])
        && b.status in ['en ligne', 'avalider', 'attente'] && b.source == 'web'
        && b.date is string && b.date.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && b.time is string && b.time.matches('^[0-2][0-9]:[0-5][0-9]$')
        && b.covers is int && b.covers >= 1
        && b.name is string && b.name.size() >= 2 && b.name.size() <= 60
        && b.phone is string && b.phone.size() >= 6 && b.phone.size() <= 25
        && (!('email' in b) || (b.email is string && b.email.size() <= 100))
        && (!('notes' in b) || (b.notes is string && b.notes.size() <= 300))
        // « Recevoir les nouvelles du restaurant » (js/clients.js): an unticked box by default, only « true » is ever sent
        && (!('optin' in b) || b.optin == true)
        && b.createdAt is int && b.createdAt > request.time.toMillis() - 600000 && b.createdAt < request.time.toMillis() + 600000
        && b.at is int && b.at < request.time.toMillis() + 400 * 86400000;
    }
    function resaOnlineOk(rid, bid) {
      let b = request.resource.data;
      let p = get(resaPubPath(rid)).data;
      let pa = getAfter(resaPubPath(rid)).data;
      let before = p.days.get(b.date, {}).get(b.time, 0);
      return resaFieldsOk(b)
        && p.cfg.online == true
        && b.covers <= p.cfg.maxOnline
        && b.at > request.time.toMillis() + p.cfg.lead * 3600000
        && (b.status == 'attente'
              // waiting list: holds no seat, no counter; only when the restaurant keeps one
              ? p.cfg.get('waitlist', true) != false
              // a booking (confirmed at once, or « à valider » when the restaurant validates each request) takes its seats on the counter
              : b.status == (p.cfg.get('validate', false) == true ? 'avalider' : 'en ligne')
                && pa.last == bid
                && pa.days[b.date][b.time] == before + b.covers
                && (p.cfg.maxPerSlot == 0 || pa.days[b.date][b.time] <= p.cfg.maxPerSlot));
    }
    // the private manage key of a booking (reserver/?r=&b=&k=): written once, with the booking, never readable by a client
    function resaKeyOk(rid, bid) {
      let k = request.resource.data;
      return k.keys().hasOnly(['k', 'at']) && k.k is string && k.k.matches('^[a-f0-9]{32}$')
        && !exists(resaBookingPath(rid, bid)) && existsAfter(resaBookingPath(rid, bid));
    }
    function resaCounterOk(rid) {
      let n = request.resource.data;
      let o = resource.data;
      let bid = n.last;
      let b = getAfter(resaBookingPath(rid, bid)).data;
      return n.diff(o).affectedKeys().hasOnly(['days', 'last'])
        && bid is string
        && !exists(resaBookingPath(rid, bid))
        && existsAfter(resaBookingPath(rid, bid))
        && b.status in ['en ligne', 'avalider']
        && n.days.diff(o.days).affectedKeys().hasOnly([b.date])
        && n.days[b.date].diff(o.days.get(b.date, {})).affectedKeys().hasOnly([b.time])
        && n.days[b.date][b.time] == o.days.get(b.date, {}).get(b.time, 0) + b.covers;
    }
    // the Growth Gusto team (js/config.js GG_ADMINS, keep both lists in sync): the admin space (js/abo.js) reads every restaurant and
    // account, and grants, extends or suspends access. A verified e-mail (or Google) is required, so nobody can claim the address.
    function isAdmin() {
      return signedIn() && request.auth.token.email in ['marceau.ruis@gmail.com']
        && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }
    // the commercial fields an admin may change on a restaurant, nothing else
    function adminKeys() { return ['plan', 'pack', 'trialEnds', 'paidUntil', 'paidAt', 'grantedBy', 'grantedAt', 'suspended', 'suspendedAt', 'suspendedBy']; }
    // what only the server (Stripe webhook, admin SDK) or an admin writes on a restaurant: nobody pays by editing their own document
    function billKeys() { return ['paidUntil', 'paidAt', 'grantedBy', 'grantedAt', 'suspended', 'suspendedAt', 'suspendedBy', 'stripe', 'activatedBy', 'activationCode']; }
    // the gérant's device stamps the 14-day trial once on a restaurant created before the trial existed
    function trialStamp() {
      return !('trialEnds' in resource.data) && request.resource.data.get('plan', 'essai') == 'essai'
        && request.resource.data.trialEnds is number && request.resource.data.trialEnds <= request.time.toMillis() + 15 * 86400000;
    }

    // ── people ──
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
      allow get, list: if isAdmin();
    }

    // ── restaurants ──
    match /restos/{rid} {
      allow read: if isMember(rid);
      allow get, list: if isAdmin();
      // a new restaurant starts on the free trial (14 days, one day of slack for clocks); paying fields are the server's (Stripe) or an admin's
      allow create: if signedIn() && request.resource.data.owner == me() && request.resource.data.name is string
                    && request.resource.data.get('plan', 'essai') == 'essai'
                    && request.resource.data.get('trialEnds', 0) <= request.time.toMillis() + 15 * 86400000
                    && !request.resource.data.keys().hasAny(billKeys());
      allow update: if isGerant(rid) && unchanged(['owner', 'createdAt', 'server', 'alertMail', 'alertState']) && unchanged(billKeys())
                       && (unchanged(['plan', 'trialEnds']) || trialStamp())
                    || isMember(rid) && unchanged(['owner', 'createdAt', 'server', 'alertMail', 'alertState', 'alertCfg', 'resaCfg', 'csCfg', 'trainingRequired', 'paCfg', 'chorePhotoStaff', 'uiDefault', 'modsOff', 'profil', 'name', 'plan', 'pack', 'trialEnds', 'drCfg']) && unchanged(billKeys())
                    || isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(adminKeys());
      allow delete: if signedIn() && resource.data.owner == me();

      // ── team: only a gérant manages it ──
      match /members/{mid} {
        // everyone reads the team; a person whose temporary access ended still reads their own doc (the app says « accès terminé »)
        allow read: if isMember(rid) || isAdmin() || (signedIn() && mid == me());
        allow create: if signedIn() && validRole(request.resource.data.role) && validPerms(request.resource.data) && (
             // the owner's own gérant membership, written in the same batch as the restaurant (no perms: a gérant has them all)
             (mid == me() && request.resource.data.role == 'gerant' && getAfter(restoPath(rid)).data.owner == me()
              && !('perms' in request.resource.data))
             // a gérant adds someone (an account or a kitchen profile), perms included
          || isGerant(rid)
             // joining with a valid invite code: the role and perms are the invite's, never chosen by the newcomer
          || (mid == me()
              && request.resource.data.invite is string
              && exists(invitePath(request.resource.data.invite))
              && get(invitePath(request.resource.data.invite)).data.rid == rid
              && get(invitePath(request.resource.data.invite)).data.role == request.resource.data.role
              && get(invitePath(request.resource.data.invite)).data.expiresAt > request.time.toMillis()
              // a temporary invite (extra, stagiaire) gives exactly its end date, never a longer one
              && request.resource.data.get('until', 0) == get(invitePath(request.resource.data.invite)).data.get('until', 0)
              && (('perms' in get(invitePath(request.resource.data.invite)).data)
                    ? request.resource.data.get('perms', null) == get(invitePath(request.resource.data.invite)).data.perms
                    : !('perms' in request.resource.data)))
        );
        // a gérant edits anyone (role, perms) but cannot demote the owner; anyone edits their own name/photo/PIN but never their role or perms
        allow update: if validRole(request.resource.data.role) && validPerms(request.resource.data) && (
             (isGerant(rid) && (mid != ownerOf(rid) || request.resource.data.role == 'gerant'))
          || (mid == me() && isMember(rid) && unchanged(['role', 'invite', 'perms', 'until', 'tmp', 'tmpFrom']))
        );
        // a gérant removes someone (never the owner); anyone can leave, except the owner;
        // the owner removes anyone, themselves included, when deleting the restaurant (the app empties every subcollection first)
        allow delete: if (isGerant(rid) && mid != ownerOf(rid)) || (signedIn() && mid == me() && ownerOf(rid) != me()) || (signedIn() && ownerOf(rid) == me());
      }

      // ── réservations: public projection, read by the booking page ──
      match /public/{doc} {
        allow get: if doc == 'resa' || doc == 'menu';
        // the booking page adds the covers of the booking it creates in the same batch, and nothing else
        allow update: if doc == 'resa' && resaCounterOk(rid);
      }
      // ── réservations: an online booking, created without an account ──
      match /bookings/{bid} {
        allow create: if resaOnlineOk(rid, bid);
      }

      // ── everything else (fridges, readings, lots, stock, tickets, staff, finances…): members only ──
      match /{col}/{doc} {
        allow read: if !(col in ['members', 'sensorKeys', 'pennylane', 'plSent', 'plInv', 'qrPay', 'bankTx', 'bank', 'push', 'consignes', 'chatGroups', 'events', 'billPays', 'notifs', 'rhDocs']) && isMember(rid);
        allow create, update, delete: if !(col in ['members', 'sensorKeys', 'pennylane', 'plSent', 'plInv', 'qrPay', 'bankTx', 'bank', 'push', 'consignes', 'chatGroups', 'events', 'billPays', 'tipCfg', 'tipMonths', 'notifs', 'rhDocs']) && isMemberAfter(rid);
      }
      // justificatifs des demandes RH (js/demandes.js: arrêt maladie, absence): medical papers, so never the whole team.
      // Read one by one (get) by the person it belongs to, a gérant, or the people of the request's circuit (readers);
      // written by the person (or by a gérant who enters the request for them), never changed afterwards; removed by the person or a gérant.
      match /rhDocs/{id} {
        allow get: if isMember(rid) && (resource.data.uid == me() || isGerant(rid) || me() in resource.data.get('readers', []));
        allow create: if isMemberAfter(rid) && request.resource.data.uid is string && request.resource.data.readers is list
                      && request.resource.data.readers.size() <= 40 && request.resource.data.data is string && request.resource.data.data.size() < 1000000
                      && (request.resource.data.uid == me() || isGerant(rid) || existsAfter(/databases/$(database)/documents/restos/$(rid)/members/$(request.resource.data.uid)));
        allow delete: if isMember(rid) && (resource.data.uid == me() || isGerant(rid));
      }
      // pourboires (js/pourboires.js): everyone reads the split and the closed months; only the gérant changes the split or closes a month
      match /tipCfg/{doc} {
        allow write: if isGerant(rid);
      }
      match /tipMonths/{mk} {
        allow write: if isGerant(rid);
      }
      // the action log (journal des actions, js/relais.js): append-only. Each line is signed by its author; nobody edits or erases it,
      // except the app's own « Annuler » right after a gesture (within 15 minutes), the « annulé ensuite » mark and the photo
      // purge of the registre, and the owner emptying the whole restaurant.
      match /events/{id} {
        allow read: if isMember(rid);
        // signed by the account, or by one of the restaurant's people on a shared device (kitchen profile: uid = their member id)
        allow create: if isMemberAfter(rid) && request.resource.data.get('uid', '') is string
                      && (request.resource.data.uid == me() || existsAfter(/databases/$(database)/documents/restos/$(rid)/members/$(request.resource.data.uid)));
        allow update: if isMember(rid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelled', 'cancelledAt', 'cancelledBy', 'photoUrl']);
        allow delete: if (isMember(rid) && resource.data.get('uid', '') is string
                          && (resource.data.uid == me() || exists(/databases/$(database)/documents/restos/$(rid)/members/$(resource.data.uid)))
                          && resource.data.get('at', 0) is number && resource.data.get('at', 0) > request.time.toMillis() - 900000)
                      || (signedIn() && ownerOf(rid) == me());
      }
      // Pennylane (js/pennylane.js, functions/src/pennylane.js): accounting, so gérants only; the server writes with admin rights
      match /pennylane/{doc} {
        allow read: if isGerant(rid);
        allow write: if isGerant(rid) && doc == 'cfg';
      }
      match /plSent/{doc} {
        allow read: if isGerant(rid);
      }
      match /plInv/{doc} {
        allow read: if isGerant(rid);
      }
      // bank operations and bank links (js/banque.js, functions/src/banque.js): money, so gérants only; the server writes with admin rights
      match /bankTx/{doc} {
        allow read, write: if isGerant(rid);
      }
      match /bank/{doc} {
        allow read, write: if isGerant(rid);
      }
      // online payments of a table's bill (functions/src/commande.js billPay): written by the server only
      match /billPays/{doc} {
        allow read: if isMember(rid);
      }
      // commande en ligne (js/commande.js, functions/src/commande.js): the restaurant's Stripe account state, written by the server only
      match /qrPay/{doc} {
        allow read: if isMember(rid);
      }
      // consignes (js/consignes.js): everyone reads; only the people allowed publish; the writer or a publisher changes or removes one
      match /consignes/{id} {
        allow read: if isMember(rid);
        allow create: if isMemberAfter(rid) && canPostConsigne(rid);
        allow update, delete: if isMember(rid) && (canPostConsigne(rid) || resource.data.uid == me());
      }
      // discussion groups (js/consignes.js): everyone reads, only a gérant creates, edits or deletes a group
      match /chatGroups/{gid} {
        allow read: if isMember(rid);
        allow write: if isGerant(rid);
      }
      // push tokens (js/consignes.js): each person writes only their own phone tokens; the server (functions/src/equipe.js) reads them with admin rights
      match /push/{mid} {
        allow read, write: if mid == me() && isMember(rid);
      }
      // notifications asked by the app (js/notifs.js « essai », other modules): written once by a member, sent and deleted by the server
      // (functions/src/notifs.js onNotifCreated); nobody reads them back
      match /notifs/{nid} {
        allow create: if isMemberAfter(rid) && request.resource.data.uid == me() && request.resource.data.kind is string
                      && request.resource.data.keys().hasOnly(['kind', 'title', 'body', 'url', 'to', 'uid', 'at']);
      }
      // sensor cloud accounts (keys, passwords) and the gateway token: gérants only; the server reads them with admin rights
      match /sensorKeys/{doc} {
        allow read, write: if isGerant(rid);
      }
    }

    // ── in-app feedback about Growth Gusto itself (written by js/avis.js): authors see theirs, admins (isAdmin above) see all ──
    match /appFeedback/{id} {
      // anyone signed in sends feedback for a restaurant they belong to; the restaurant's team sees its own; admins see all
      allow create: if signedIn() && request.resource.data.uid == me() && request.resource.data.rid is string && isMember(request.resource.data.rid);
      allow get, list: if isAdmin() || (signedIn() && (resource.data.uid == me() || isMember(resource.data.rid)));
      allow update, delete: if isAdmin();
    }

    // ── réservations: private manage keys (written by the booking page with its booking, read only by the server) ──
    match /resaKeys/{rid}/keys/{bid} {
      allow create: if resaKeyOk(rid, bid);
    }

    // ── invites: readable by whoever has the code, managed by the restaurant's gérants ──
    // read by every app: is online payment (Stripe) switched on (written by functions/src/stripe.js only)
    match /ggPublic/{doc} {
      allow read: if true;
    }
    match /invites/{code} {
      allow get: if true;
      allow list: if isGerant(resource.data.rid);
      allow create: if isGerant(request.resource.data.rid)
                    && request.resource.data.createdBy == me()
                    && validRole(request.resource.data.role)
                    && validPerms(request.resource.data)
                    && request.resource.data.uses == 0
                    && request.resource.data.expiresAt is number;
      allow update: if isGerant(resource.data.rid) && unchanged(['rid', 'createdBy']) && validPerms(request.resource.data)
                    // a newcomer counts their use, nothing else
                    || (signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses', 'lastUsedAt'])
                        && request.resource.data.uses == resource.data.uses + 1
                        && resource.data.expiresAt > request.time.toMillis());
      allow delete: if isGerant(resource.data.rid);
    }
  }
}
